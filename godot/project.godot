; Engine configuration file.
; Fermer l'éditeur Godot pendant que Claude modifie ce fichier.

config_version=5

[application]

config/name="Port Horizon V2"
config/description="Idle tycoon de terminal à conteneurs"
config/version="2.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/icons/app.svg"

[autoload]

Settings="*res://autoload/settings.gd"
GameState="*res://autoload/game_state.gd"
Sim="*res://autoload/sim_runner.gd"
Save="*res://autoload/save.gd"
Sfx="*res://autoload/sfx.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
